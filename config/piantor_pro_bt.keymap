#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include "keys_it.h"

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&num_word { continue-list = <LPAR RPAR EQUAL SLASH MINUS ASTRK PLUS PRCNT COMMA KP_DOT>; };

&caps_word { continue-list = <SPACE>; };

&mt {
    tapping-term-ms = <130>; // This is the value already set by default
    flavor = "balanced";
};

/ {
    macros {
        Passpc: Passpc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1>;
        };

        Passfirma: Passfirma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N3 &kp N0 &kp N0 &kp N2 &kp N0 &kp N9 &kp N9>;
        };


        apri_cal_c: apri_cal_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                /* 1. Apre Esegui (Win + R) */
                = <&kp LG(R)>
            
                /* 2. Pausa nativa: usiamo una serie di kp NONE sequenziali invece di macro_wait_time */
                , <&kp NONE &kp NONE &kp NONE &kp NONE &kp NONE>
            
                /* 3. Inserisce il link diretto all'editor eventi di Calendar e preme Invio */
                , <&kp C &kp H &kp R &kp O &kp M &kp E &kp SPACE &kp C &kp A &kp L &kp E &kp N &kp D &kp A &kp R &kp DOT &kp G &kp O &kp O &kp G &kp L &kp E &kp DOT &kp C &kp O &kp M &kp SLASH &kp C &kp A &kp L &kp E &kp N &kp D &kp A &kp R &kp SLASH &kp U &kp SLASH &kp N0 &kp SLASH &kp R &kp SLASH &kp E &kp V &kp E &kp N &kp T &kp E &kp D &kp I &kp T &kp RET>
                ;
        };
    };
};



/ {
    nav_word: nav_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <LG(T) LG(DOWN_ARROW) LG(UP_ARROW) LG(LEFT_ARROW) LG(RIGHT_ARROW) LC(LS(LEFT_ARROW)) LC(LS(RIGHT_ARROW)) LEFT_ARROW UP_ARROW RIGHT_ARROW DOWN_ARROW>;
        ignore-modifiers;
    };

    mau_word: mau_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <MB2 MB3 MB1 MOVE_LEFT MOVE_UP MOVE_RIGHT MOVE_DOWN SCRL_UP SCRL_DOWN SCRL_RIGHT SCRL_LEFT>;
        ignore-modifiers;
    };
};

/ {
    behaviors {
        my_mt: my_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <130>;
            bindings = <&kp>, <&sk>;

            display-name = "Mod-Tap";
        };

        copiaincolla: copiaincolla {
            compatible = "zmk,behavior-hold-tap";
            label = "COPIAINCOLLA";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <28 26 27>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp BSPC>;
        };

        combo_space {
            timeout-ms = <60>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ENTER>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <28 27>;
        };

        maiusc {
            bindings = <&caps_word>;
            key-positions = <38 39>;
        };

        apostrofo {
            bindings = <&kp APOS>;
            key-positions = <19 20 21>;
        };
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QWERTY";
            bindings = <
&trans  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp ESC  &none  &none  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp P  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp KP_DOT  &kp TAB  &none  &sl 5  &num_word 2  &sk LEFT_SHIFT  &sl 3  &nav_word 1  &mau_word 4
            >;
        };

        FRECCE {
            display-name = "FRECCE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &kp LG(DOWN_ARROW)  &trans  &trans  &sk LEFT_ALT  &sk LEFT_GUI  &sk LEFT_CONTROL  &sk LEFT_SHIFT  &trans  &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LS(LEFT_ARROW))  &trans  &kp LC(LS(RIGHT_ARROW))  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUMBER {
            display-name = "NUMERI";
            bindings = <
&trans  &kp ASTRK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp SLASH  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PLUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS  &trans  &sk RIGHT_SHIFT  &sk RIGHT_CONTROL  &sk RIGHT_GUI  &sk RIGHT_ALT  &trans  &trans  &kp EQUAL  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp ENTER  &trans  &trans  &trans  &trans  &trans  &trans  &kp COMMA  &trans  &kp KP_N0  &trans  &trans  &trans
            >;
        };

        SIMBOLI {
            display-name = "SIMBOLI";
            bindings = <
&trans  &kp DOLLAR  &kp LESS_THAN  &kp LEFT_BRACE  &kp LBKT  &caps_word  &kp SEMI  &kp COLON  &kp EXCL  &kp QUESTION  &Passpc  &none  &trans  &kp HASH  &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp F2  &kp DQT  &kp LPAR  &kp RPAR  &kp UNDER  &Passfirma  &none  &trans  &kp BACKSLASH  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp AMPS  &kp SLASH  &kp AT  &kp HOME  &kp PERCENT  &kp PRINTSCREEN  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &msc SCRL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &mkp MB2  &mkp MB3  &mkp MB1  &msc SCRL_RIGHT  &trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mmv MOVE_DOWN  &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        media {
            display-name = "MEDIA";
            bindings = <
&trans  &bt BT_SEL 0  &trans  &trans  &kp C_VOLUME_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 1  &kp C_PREVIOUS  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp LG(DOT)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 2  &trans  &trans  &kp C_VOLUME_DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "MEDIA";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        querty1 {
            if-layers = <1 2>;
            then-layer = <0>;
        };

        querty2 {
            if-layers = <2 4>;
            then-layer = <0>;
        };

        querty3 {
            if-layers = <1 4>;
            then-layer = <0>;
        };
    };
};
