#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include "keys_it.h"

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&num_word { continue-list = <LPAR RPAR IT_EQUAL SLASH MINUS ASTRK PLUS PRCNT COMMA DOT>; };

&caps_word { continue-list = <SPACE>; };

&mt {
    tapping-term-ms = <130>; // This is the value already set by default
};

/ {
    macros {
        Passpc: Passpc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1>;
        };

        Passfirma: Passfirma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N3 &kp N0 &kp N0 &kp N2 &kp N0 &kp N9 &kp N9>;
        };
    };
};

/ {
    behaviors {
        nav_word: nav_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <LEFT DOWN UP RIGHT PG_DN PG_UP>;
            ignore-modifiers;
        };

        play_y: play_y {
            compatible = "zmk,behavior-tap-dance";
            label = "PLAY_Y";
            #binding-cells = <0>;
            bindings = <&kp Y>, <&kp C_PLAY_PAUSE>;
        };

        shift_j: shift_j {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_J";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&kp J>;
        };

        ctrl_k: ctrl_k {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_K";
            #binding-cells = <0>;
            bindings = <&sk LEFT_CONTROL>, <&kp K>;
        };

        mau_word: mau_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <MB2 MB3 MB1 MOVE_LEFT MOVE_UP MOVE_RIGHT MOVE_DOWN SCRL_UP SCRL_DOWN SCRL_RIGHT SCRL_LEFT DEL ESC SPACE>;
            ignore-modifiers;
            label = "MAU_WORD";
        };

        frecce_dx_su: frecce_dx_su {
            compatible = "zmk,behavior-hold-tap";
            label = "FRECCE_DX_SU";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <41>;
        };

        frecce_sx_giu: frecce_sx_giu {
            compatible = "zmk,behavior-hold-tap";
            label = "FRECCE_SX_GIU";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <36>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp BSPC>;
        };

        combo_space {
            timeout-ms = <60>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ENTER>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <28 27>;
        };

        num {
            bindings = <&num_word 2>;
            key-positions = <2 14>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <5 17>;
        };

        tab2 {
            bindings = <&kp TAB>;
            key-positions = <17 29>;
        };

        maus {
            bindings = <&mau_word 4>;
            key-positions = <28 16>;
        };

        naviga {
            bindings = <&nav_word 1>;
            key-positions = <26 14>;
        };

        base {
            bindings = <&tog 0>;
            key-positions = <15 27>;
        };

        apos {
            bindings = <&kp APOS>;
            key-positions = <19 31>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <20 32>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QWERTY";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &play_y  &kp U  &kp I  &kp O  &sk LEFT_ALT  &none  &none  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &shift_j  &ctrl_k  &kp L  &kp P  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp KP_DOT  &sk LEFT_GUI  &none  &kp DOWN  &kp LEFT_ARROW  &caps_word  &sl 3  &kp RIGHT_ARROW  &kp UP_ARROW
            >;
        };

        FRECCE {
            display-name = "OPZIONI";
            bindings = <
&trans  &trans  &trans  &bt BT_NXT  &kp PAGE_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_PRV  &kp PAGE_DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUMBER {
            display-name = "NUMERI";
            bindings = <
&trans  &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &mt ASTRK SLASH  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &mt PLUS MINUS  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &mt EQUAL ENTER  &trans  &trans  &trans  &trans  &trans  &trans  &kp BSPC  &kp COMMA  &kp KP_N0  &trans  &trans  &trans
            >;
        };

        SIMBOLI {
            display-name = "SIMBOLI";
            bindings = <
&trans  &mt POUND AMPS  &mt GT LT  &mt BSLH DOLLAR  &mt LBKT RBKT  &mt LBRC RBRC  &kp SEMI  &kp COLON  &kp EXCL  &kp QUESTION  &Passpc  &none  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp DQT  &kp LPAR  &kp RPAR  &kp UNDER  &Passfirma  &none  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp SLASH  &kp AT  &kp HOME  &kp PERCENT  &kp PRINTSCREEN  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP  &kp ESC  &kp DEL  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &mkp MB1  &mkp MB3  &mkp MB2  &msc SCRL_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &kp SPACE  &kp ENTER  &trans  &trans  &mmv MOVE_DOWN  &mmv MOVE_LEFT  &trans  &trans  &mmv MOVE_RIGHT  &mmv MOVE_UP
            >;
        };
    };
};
