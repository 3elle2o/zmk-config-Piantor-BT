#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include "keys_it.h"

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&num_word { continue-list = <LPAR RPAR IT_EQUAL SLASH MINUS ASTRK PLUS PRCNT COMMA DOT>; };

&caps_word { continue-list = <SPACE>; };

&mt {
    tapping-term-ms = <130>; // This is the value already set by default
};

/ {
    macros {
        Passpc: Passpc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1>;
        };

        Passfirma: Passfirma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N3 &kp N0 &kp N0 &kp N2 &kp N0 &kp N9 &kp N9>;
        };
    };
};

/ {
    behaviors {
        nav_word: nav_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <LEFT DOWN UP RIGHT PG_DN PG_UP>;
            ignore-modifiers;
        };

        caps_y: caps_y {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS_Y";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp Y>;
        };

        grave_j: grave_j {
            compatible = "zmk,behavior-tap-dance";
            label = "GRAVE_J";
            #binding-cells = <0>;
            bindings = <&kp APOS>, <&kp J>;
        };

        base_k: base_k {
            compatible = "zmk,behavior-tap-dance";
            label = "BASE_K";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp K>;
        };

        num_w: num_w {
            compatible = "zmk,behavior-tap-dance";
            label = "NUM_W";
            #binding-cells = <0>;
            bindings = <&num_word 2>, <&kp W>;
        };

        mau_word: mau_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <MB2 MB3 MB1 MOVE_LEFT MOVE_UP MOVE_RIGHT MOVE_DOWN SCRL_UP SCRL_DOWN SCRL_RIGHT SCRL_LEFT>;
            ignore-modifiers;
            label = "MAU_WORD";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp BSPC>;
        };

        combo_space {
            timeout-ms = <60>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ENTER>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp DEL>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };

        apos {
            bindings = <&kp APOS>;
            key-positions = <18 19>;
            timeout-ms = <50>;
        };

        capslock {
            bindings = <&num_word 2>;
            key-positions = <2 14>;
            timeout-ms = <50>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <28 29>;
        };

        grave {
            bindings = <&kp APOS>;
            key-positions = <30 31>;
            timeout-ms = <50>;
        };

        caps {
            bindings = <&caps_word>;
            key-positions = <21 9>;
            timeout-ms = <50>;
        };

        scrol_up {
            bindings = <&msc SCRL_UP>;
            key-positions = <7 9>;
            layers = <4>;
        };

        scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <31 33>;
            layers = <4>;
        };

        scroll_dx {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <9 21>;
            layers = <4>;
        };

        scroll_sx {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <19 7>;
            layers = <4>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QTERY";
            bindings = <
&none  &kp Q  &kp T  &kp E  &kp R  &num_w  &caps_y  &kp U  &kp I  &kp O  &kp C_PLAY_PAUSE  &none  &none  &kp A  &kp S  &kp D  &kp F  &kp G  &grave_j  &kp N  &kp H  &kp L  &kp P  &none  &none  &mt LC(Z) Z  &kp B  &kp C  &kp V  &kp X  &base_k  &kp M  &kp COMMA  &kp DOT  &mau_word 4  &none  &none  &sk LCTRL  &sk LSHIFT  &sl 3  &nav_word 1  &none
            >;
        };

        FRECCE {
            display-name = "FRECCE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PG_UP  &trans  &kp PG_DN  &trans  &trans  &trans  &sk LEFT_WIN  &sk LALT  &sk LCTRL  &sk LSHFT  &kp DEL  &trans  &kp LEFT  &kp UP  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DOWN_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUMBER {
            display-name = "NUMBER";
            bindings = <
&trans  &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &mt ASTRK SLASH  &bt BT_NXT  &trans  &trans  &trans  &trans  &none  &trans  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &mt PLUS MINUS  &bt BT_PRV  &trans  &trans  &trans  &trans  &none  &trans  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &mt EQUAL ENTER  &trans  &trans  &trans  &trans  &trans  &trans  &none  &kp IT_COMMA  &kp KP_N0  &trans  &trans  &trans
            >;
        };

        SIMBOLI {
            display-name = "SIMBOLI";
            bindings = <
&trans  &mt POUND AMPS  &kp C_NEXT  &mt BSLH DOLLAR  &mt LBKT RBKT  &mt LBRC RBRC  &kp SEMI  &kp COLON  &kp EXCL  &kp QUESTION  &Passpc  &none  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp DQT  &kp LPAR  &kp RPAR  &kp UNDER  &Passfirma  &none  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp SLASH  &kp AT  &kp HOME  &kp PERCENT  &kp PRINTSCREEN  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB2  &mkp MB3  &mkp MB1  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
